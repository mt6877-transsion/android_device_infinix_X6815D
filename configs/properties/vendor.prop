# Audio
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
persist.vendor.rm.debug.headsetmic=1
persist.vendor.rm.debug.phonemic=1
ro.audio.monitorRotation=true
ro.config.media_vol_default=10
ro.config.vc_call_vol_default=4
ro.config.vc_call_vol_steps=11
ro.vendor.mtk_audio_alac_support=1
ro.vendor.mtk_audio_tuning_tool_ver=V1
ro.vendor.mtk_audio_ape_support=1
ro.vendor.mtk_hifiaudio_support=1
vendor.streamin.pcm.dump=0
vendor.streamout.pcm.dump=0
vendor.usbsph.dl.pcm.dump=0
vendor.usbsph.srcaws.pcm.dump=0
vendor.usbsph.ul.pcm.dump=0

# Bluetooth
bluetooth.profile.sap.server.enabled=true
persist.bluetooth.a2dp_offload.cap=sbc-aac
persist.bluetooth.a2dp_offload.disabled=true
ro.vendor.bt.platform=6877
ro.vendor.mtk.bt_sap_enable=true
vendor.bluetooth.ldac.abr=true

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts

# Display
debug.cpurend.vsync=false
graphics.gpu.profiler.support=true
debug.mediatek.appgamepq_compress=1
debug.mediatek.disp_decompress=1
persist.vendor.uxcompaction_enable=true
persist.vendor.sys.mtkaal.function=0
ro.hardware.egl=meow
ro.hardware.hwcomposer=mtk_common
ro.hardware.vulkan=mali
ro.vendor.composer_version=2.3
ro.vendor.mml.mtk_mml_support=0
ro.vendor.mtk_aal_support=1
ro.vendor.mtk_ovl_bringup=0
ro.vendor.mtk_pq_color_mode=1
ro.vendor.mtk_pq_support=2
ro.vendor.pq.disp_lcm_name_support=0
ro.vendor.pq.mtk_aal_support=1
ro.vendor.pq.mtk_ai_scence_pq_support=0
ro.vendor.pq.mtk_ai_sdr_to_hdr_support=0
ro.vendor.pq.mtk_backlight_smooth_support=0
ro.vendor.pq.mtk_blulight_def_support=1
ro.vendor.pq.mtk_caltm_support=1
ro.vendor.pq.mtk_clearzoom_support=1
ro.vendor.pq.mtk_dc_support=1
ro.vendor.pq.mtk_disp_c3d_support=0
ro.vendor.pq.mtk_disp_ccorr_support=1
ro.vendor.pq.mtk_disp_color_support=1
ro.vendor.pq.mtk_disp_game_pq_support=1
ro.vendor.pq.mtk_disp_gamma_support=1
ro.vendor.pq.mtk_disp_tdshp_support=0
ro.vendor.pq.mtk_dre30_support=0
ro.vendor.pq.mtk_ds_support=1
ro.vendor.pq.mtk_hdr10_plus_recording_support=0
ro.vendor.pq.mtk_hfg_support=1
ro.vendor.pq.mtk_mdp_ccorr_support=1
ro.vendor.pq.mtk_mdp_lite_pq_support=0
ro.vendor.pq.mtk_pq_interface_support=0
ro.vendor.pq.mtk_pq_video_whitelist_support=0
ro.vendor.pq.mtk_scltm_support=0
ro.vendor.pq.mtk_ultra_dimming_support=0
ro.vendor.pq.mtk_ultra_resolution_support=1
ro.vendor.pq.mtk_video_transition=0
ro.vendor.smvr.p2batch.fhd=8
ro.vendor.smvr.p2batch.hd=16
ro.vendor.smvr.p2batch.vga=32
ro.vendor.tgpa_resolution_tuner=1
ro.vendor.tgpa_scaler_time=20200407
ro.vendor.tgpa_scaler_version=1

# DRM
drm.service.enabled=true
ro.netflix.bsp_rev=MTK6877-33678-1
ro.vendor.mtk_widevine_drm_l1_support=1

# Gatekeeper
ro.hardware.gatekeeper=trustonic

# Graphics
debug.graphics.game_default_frame_rate.disabled=true
ro.opengles.version=196610

# HWUI
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=60
debug.sf.enable_adpf_cpu_hint=true

# HWComposer
ro.vendor.mtk_backlight_hwc_support=0
ro.vendor.composer_version=2.3

# Neural Networks
debug.mtk_tflite.target_nnapi=29
ro.vendor.mtk_nn.option=A,B,E,F,Z
ro.vendor.mtk_nn_baseline_support=1
ro.vendor.mtk_nn_quant_preferred=1
ro.vendor.mtk_nn_support=1

# SurfaceFlinger
debug.sf.disable_client_composition_cache=0
debug.sf.disable_backpressure=0
debug.sf.early.app.duration=14600000
debug.sf.earlyGl.app.duration=14600000
debug.sf.earlyGl.sf.duration=13100000
debug.sf.early.sf.duration=13100000
debug.sf.enable_gl_backpressure=0
debug.sf.enable_adpf_cpu_hint=true
debug.sf.enable_hwc_vds=0
debug.sf.enable_transaction_tracing=false
debug.sf.frame_rate_multiple_threshold=120
debug.sf.hwc.min.duration=2000000
debug.sf.late.app.duration=14600000
debug.sf.late.sf.duration=13100000
debug.sf.set_binder_thread_rt=1
debug.sf.use_phase_offsets_as_durations=1
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=4
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.protected_contents=true
ro.surface_flinger.set_idle_timer_ms=1100
ro.surface_flinger.uclamp.min=328
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.wcg_composition_dataspace=143261696
debug.sf.enable_egl_image_tracker=0